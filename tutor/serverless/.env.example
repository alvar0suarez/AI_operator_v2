# Configuración del tutor. Se copia a .env en local y a las variables de entorno
# del proveedor en producción.
#
# ESPECIFICACION.md §7.5: la clave NUNCA va en el cliente, ni en el HTML, ni en una
# variable de build, ni en el repositorio. Solo aquí, en el servidor.

ANTHROPIC_API_KEY=sk-ant-...

# Almacén del registro de preguntas (§7.4): {nodo_id, pregunta, timestamp, modo}.
# En Cloudflare es un KV namespace enlazado con este nombre. Si no está
# configurado, el tutor funciona igual y no registra nada.
# REGISTRO_PREGUNTAS=
